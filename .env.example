# Ncodex core never requires a private key or API credential.
# Live trading intentionally unsupported.
NCODEX_MODE=paper
NCODEX_DB=paper.db
# Mobile reference server; generate a random value if binding beyond loopback.
# Keep private; never commit an actual value.
NCODEX_ACCESS_TOKEN=
# Optional Freqtrade LOCAL dry-run connection, only read-only endpoints used.
FREQTRADE_API_URL=
FREQTRADE_API_USER=
FREQTRADE_API_PASSWORD=
# TradingAgents: authorize on host with 'tradingagents login chatgpt'
