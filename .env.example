# Ncodex core never requires a private key or API credential.
# Live trading intentionally unsupported.
NCODEX_MODE=paper
NCODEX_DB=paper.db
# Mobile reference server; generate a random value if binding beyond loopback.
# Keep private; never commit an actual value.
NCODEX_ACCESS_TOKEN=
# Optional Freqtrade LOCAL dry-run connection, only read-only endpoints used.
FREQTRADE_API_URL=
FREQTRADE_API_USER=
FREQTRADE_API_PASSWORD=
# TradingAgents: authorize on host with 'tradingagents login chatgpt'


# Optional ChatGPT Plus/Pro subscription authentication for the
# owner's self-hosted, long-running TradingAgents server.
# An authenticated, private HTTPS reverse proxy is required for remote use.
# Generate an NCODEX_ACCESS_TOKEN with at least 20 random characters.
NCODEX_ENABLE_CHATGPT_CONNECT=0
# No OPENAI_API_KEY required for the TradingAgents ChatGPT subscription flow.
# Sign-in credentials remain in ~/.tradingagents/chatgpt-auth.json on the server.
